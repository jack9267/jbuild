* text=auto

# Windows-only scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Makefiles are Unix-only: a CR in a recipe or variable breaks GNU make.
*.mk  text eol=lf
Makefile text eol=lf
makefile text eol=lf

# Binary: premake itself (and any libs/dlls that ever land here).
*.exe binary
*.lib binary
*.dll binary
